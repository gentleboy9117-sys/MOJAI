{
  "name": "prosecution-planning-ai-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "AI 기반 검찰 기획업무 자동화 플랫폼 — 오전 이슈 모니터링·브리핑 + 사건 처리 후 검찰발표자료 초안 생성 (MVP)",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/netlify-prisma.mjs",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "setup": "prisma generate && prisma db push && tsx prisma/seed.ts",
    "sync:offices": "tsx scripts/sync-offices.ts",
    "collect:news": "tsx scripts/collect-news.ts",
    "classify": "tsx scripts/classify-articles.ts",
    "cluster": "tsx scripts/cluster-issues.ts",
    "trend": "tsx scripts/generate-trend-alerts.ts",
    "briefing": "tsx scripts/daily-briefing.ts",
    "auto:collect": "tsx scripts/auto-collect.ts",
    "crawl:press": "tsx scripts/crawl-spo-press-releases.ts",
    "analyze:press": "tsx scripts/analyze-press-release-style.ts",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@tailwindcss/typography": "^0.5.15",
    "@xyflow/react": "^12.11.0",
    "cheerio": "^1.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.456.0",
    "marked": "^14.1.4",
    "next": "^14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rss-parser": "^3.13.0",
    "sanitize-html": "^2.13.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sanitize-html": "^2.13.0",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.18",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
