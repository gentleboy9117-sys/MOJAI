# =====================================================================
# Prosecution Issue Monitor — 환경변수 예시
# 실제 값은 .env 에 저장하고 절대 커밋하지 않는다.
# =====================================================================

# ---- 실행 모드 -------------------------------------------------------
# development | test | production
# production 모드에서는 DevCrawlerProvider 가 비활성화된다.
APP_MODE="development"

# ---- 데이터베이스 ---------------------------------------------------
# MVP: SQLite. 운영 확장 시 PostgreSQL 로 교체.
#   예) postgresql://user:pass@localhost:5432/prosecution?schema=public
DATABASE_URL="file:./dev.db"

# ---- LLM Provider ---------------------------------------------------
# mock | openai | local
#   mock  : API 키 없이 오프라인 동작 (기본값/데모)
#   openai: OpenAI 호환 API
#   local : 내부망 설치형 LLM (OpenAI 호환 엔드포인트)
LLM_PROVIDER="mock"

# OpenAI / OpenAI 호환
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# 내부망 설치형 LLM (OpenAI 호환 엔드포인트, 예: vLLM/Ollama/사내 게이트웨이)
LOCAL_LLM_BASE_URL="http://localhost:11434/v1"
LOCAL_LLM_MODEL="qwen2.5"
LOCAL_LLM_API_KEY=""

# LLM 으로 전송하는 본문 최대 길이(문자). 원문 전체를 보내지 않는다.
LLM_MAX_INPUT_CHARS="1500"

# ---- 뉴스 수집(News) Provider 모드 ----------------------------------
# public  : 공식 보도자료(검찰청/법무부) + 공개 RSS 만
# licensed: 라이선스 뉴스 API (mock 포함)
# dev     : DevCrawlerProvider 허용 (development 모드에서만 동작)
NEWS_PROVIDER_MODE="public"

# 외부 fetch 허용 도메인 (allowlist). 콤마로 구분. 비우면 기본 allowlist 사용.
FETCH_ALLOWLIST="www.spo.go.kr,spo.go.kr,www.moj.go.kr,moj.go.kr"

# 수집 rate limit (분당 요청 수)
COLLECT_RATE_LIMIT_PER_MIN="20"
COLLECT_USER_AGENT="ProsecutionIssueMonitor/0.1 (+internal-monitoring; contact=admin@example.go.kr)"

# ---- 보안 -----------------------------------------------------------
# 저장 데이터 암호화 키 (32바이트 hex 권장). 비우면 암호화 비활성(개발용).
#   생성 예) openssl rand -hex 32
DATA_ENCRYPTION_KEY=""

# 감사로그/보고서 생성자 식별(데모용 헤더 기반 인증). 운영은 기관 SSO 로 대체.
#   개발 시 기본 사용자/권한
DEV_DEFAULT_USER_EMAIL="analyst@example.go.kr"
DEV_DEFAULT_USER_ROLE="ANALYST"
